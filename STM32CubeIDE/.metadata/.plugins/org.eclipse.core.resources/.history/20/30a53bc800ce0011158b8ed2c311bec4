// ######################################################################################################################################



#define SCAN_PERIOD_MS	10
#define BLINK_PERIOD_MS	250

#define COLOR_RED    0
#define COLOR_AMBER  1
#define COLOR_GREEN  2
#define TRAFFIC_TICK_MS 1000

static int led_buffer[4] = { 0, 0, 0, 0 };
static int index_led = 0;

static GPIO_TypeDef *const enPort[4] = { EN0_GPIO_Port, EN1_GPIO_Port, EN2_GPIO_Port, EN3_GPIO_Port };
static const uint16_t enPin[4]       = { EN0_Pin, EN1_Pin, EN2_Pin, EN3_Pin };

static GPIO_TypeDef *const ledPort[3][2] =
{
    { RED1_GPIO_Port,    RED2_GPIO_Port    },
    { YELLOW1_GPIO_Port, YELLOW2_GPIO_Port },
    { GREEN1_GPIO_Port,  GREEN2_GPIO_Port  }
};

static const uint16_t ledPin[3][2] =
{
    { RED1_Pin,    RED2_Pin    },
    { YELLOW1_Pin, YELLOW2_Pin },
    { GREEN1_Pin,  GREEN2_Pin  }
};

static void set_road(int road, int color)      // road 0 = Road 1, road 1 = Road 2
{
    for (int c = 0; c < 3; c++)
        HAL_GPIO_WritePin(ledPort[c][road], ledPin[c][road], GPIO_PIN_SET);      // all off
    HAL_GPIO_WritePin(ledPort[color][road], ledPin[color][road], GPIO_PIN_RESET); // chosen on
}



// ######################################################################################################################################
// ######################################################################################################################################
// ######################################################################################################################################



void display7SEG(int num)
{
    if (num < 0 || num > 9) return;

	HAL_GPIO_WritePin(EN0_GPIO_Port, EN0_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(EN1_GPIO_Port, EN1_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(EN2_GPIO_Port, EN2_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(EN3_GPIO_Port, EN3_Pin, GPIO_PIN_SET);

    for (int i = 0; i < 7; i++)
        HAL_GPIO_WritePin(segments[i].port, segments[i].pin, digitPatterns[num][i]);
}



