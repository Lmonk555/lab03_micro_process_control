#include "main.h"
#include "input_reading.h"
#include "input_processing.h"


enum ButtonState
{
    BUTTON_RELEASED,
    BUTTON_PRESSED,
    BUTTON_PRESSED_MORE_THAN_1_SECOND
};
enum ButtonState buttonState = BUTTON_RELEASED;


// From ex05
static int mode = MODE_NORMAL;


// From ex06
static int duration[3] = { 5, 2, 3 };   // default R, A, G in seconds


// From ex07-08-09
#define NUM_BUTTONS    3
#define AUTO_REPEAT_MS 500

static int tempValue = 0;



// ######################################################################################################################################
// ######################################################################################################################################
// ######################################################################################################################################



// From ex05
int get_mode(void)
{
    return mode;
}


// From ex06
int get_duration(int index)
{
    if (index < 0 || index > 2) return 0;
    return duration[index];
}


// From ex07
int get_temp(void)
{
	return tempValue;
}


// What each button does when it is pressed (or auto-repeated)
static void button_action(int index)
{
    switch (index)
    {
		case 0:			// B0: next mode
			mode++;
			if (mode > MODE_MAX)
				mode = MODE_NORMAL;


			if (mode == MODE_NORMAL)
			    tempValue = 0;
			else
			    tempValue = duration[mode - MODE_RED];
			break;


		case 1:			// B1: increase temp value
			if (mode != MODE_NORMAL)
			{
				tempValue++;
				if (tempValue > 99) tempValue = 1;
			}
			break;


		case 2:			// B2: set (save) the value
			if (mode != MODE_NORMAL)
				duration[mode - MODE_RED] = tempValue;
			break;
    }
}













// ######################################################################################################################################
// ######################################################################################################################################
// ######################################################################################################################################



void fsm_for_input_processing(void)
{
    switch(buttonState)
    {
		case BUTTON_RELEASED:
			if(is_button_pressed(0))
			{
				buttonState = BUTTON_PRESSED;
				mode++;							// INCREASE VALUE OF PORT A BY ONE UNIT

				if (mode > MODE_MAX)
					mode = MODE_NORMAL;
			}
			break;


		case BUTTON_PRESSED:
			if(!is_button_pressed(0))
			{
				buttonState = BUTTON_RELEASED;
			}
			else if(is_button_pressed_1s(0))
			{
				buttonState = BUTTON_PRESSED_MORE_THAN_1_SECOND;
			}
			break;


		case BUTTON_PRESSED_MORE_THAN_1_SECOND:
			if(!is_button_pressed(0))
			{
				buttonState = BUTTON_RELEASED;
			}
			break;
    }
}








